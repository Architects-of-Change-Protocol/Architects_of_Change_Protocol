{
  "name": "@aoc/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Public contracts, semantics, schemas, and compatibility definitions for AOC Protocol.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Architects-of-Change-Protocol/Architects_of_Change_Protocol.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/Architects-of-Change-Protocol/Architects_of_Change_Protocol/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/Architects-of-Change-Protocol/Architects_of_Change_Protocol/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/contracts/index.js",
  "types": "./dist/contracts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./claims": {
      "types": "./dist/claims/index.d.ts",
      "default": "./dist/claims/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./runtime-registry": {
      "types": "./dist/runtime-registry/index.d.ts",
      "default": "./dist/runtime-registry/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical/index.d.ts",
      "default": "./dist/canonical/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./sovereignty-capabilities": {
      "types": "./dist/sovereignty-capabilities/index.d.ts",
      "default": "./dist/sovereignty-capabilities/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
